POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hnl_user
POSTGRES_PASSWORD=hnl_password
POSTGRES_DB=hnl_wallet

DATA_FILE=../data/data.json

JWT_SECRET=change-me

# Optional: enables POST /chat. Leave OPENROUTER_API_KEY empty to disable chat
# without affecting the rest of the API. Model ids change over time — check
# https://openrouter.ai/models for current ones (":free" suffix = no credits
# needed, e.g. openai/gpt-oss-20b:free, useful for testing).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Where the main API (this .env) can reach the MCP server, and vice versa
# (cmd/mcp-server reads HNL_API_URL / MCP_SERVER_PORT from the same file).
MCP_SERVER_URL=http://localhost:8081/mcp
HNL_API_URL=http://localhost:8080
MCP_SERVER_PORT=8081

# Frontend origin allowed to call this API from a browser (see backend/api/cors.go)
FRONTEND_URL=http://localhost:5173
